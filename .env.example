# Millwater PMS API (backend)

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5432/millwater_pms?schema=public"

# Port the API listens on (Render sets this automatically).
PORT=4000

# Random secret of at least 32 characters, used once to create the first administrator.
MILLWATER_BOOTSTRAP_KEY=""

# Production only --------------------------------------------------------------
# NODE_ENV=production makes the session cookie Secure (HTTPS only).
# NODE_ENV=production

# Frontend origins allowed to make changes, comma-separated (your Vercel URL[s]).
# ALLOWED_ORIGINS=https://millwater-pms.vercel.app

# Proxies in front of the API: Vercel rewrite + Render load balancer = 2.
# TRUST_PROXY=2

# Demonstration data: when "true", the server loads the sample network, customers and
# three months of billing history on startup (billing history only if none exists yet).
# Turn it off before entering real data.
SEED_DEMO_DATA=false

# Encrypts secrets saved in Settings (e.g. the AMI token). 32+ random characters.
# Keep it stable: changing it makes saved secrets unreadable (re-enter them in Settings).
SETTINGS_ENCRYPTION_KEY=""

# Email ------------------------------------------------------------------------
# EMAIL_PROVIDER picks where onboarding emails go:
#   mailtrap  Demo: Mailtrap Email Sandbox catches every message in a test inbox; nothing is delivered.
#   resend    Live: real delivery through Resend, once the client's domain is verified (DNS records).
EMAIL_PROVIDER="mailtrap"
# Mailtrap sandbox: API token (Settings -> API Tokens) and the numeric inbox id from the inbox URL.
MAILTRAP_API_TOKEN=""
MAILTRAP_INBOX_ID=""
# Resend: API key from resend.com; EMAIL_FROM must use the domain verified there.
RESEND_API_KEY=""
# Sender. Required for Resend; optional for Mailtrap (a demo sender is used).
EMAIL_FROM="Millwater <onboarding@your-verified-domain>"
# Optional: replies go to the customer's support contacts; this is used if none are set.
EMAIL_REPLY_TO=""
# Public base URL that email images (logo) are loaded from. Defaults to the first
# ALLOWED_ORIGINS entry, which serves /api/email-assets through the frontend.
EMAIL_ASSET_BASE_URL=""

# AMI connection --------------------------------------------------------------
# Normally entered by an administrator in Settings. These are only a fallback.
AMI_API_BASE_URL=""
AMI_API_TOKEN=""
AMI_ALLOW_INSECURE_HTTP=false
